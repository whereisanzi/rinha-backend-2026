FROM --platform=linux/amd64 rust:1.83-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /src

ENV RUSTFLAGS="-C link-arg=-s"

COPY Cargo.toml Cargo.lock ./
COPY crates/api/Cargo.toml ./crates/api/Cargo.toml
COPY crates/build-index/Cargo.toml ./crates/build-index/Cargo.toml
COPY crates/init-copy/Cargo.toml ./crates/init-copy/Cargo.toml
RUN mkdir -p crates/api/src crates/build-index/src crates/init-copy/src \
    && echo 'fn main() {}' > crates/api/src/main.rs \
    && echo 'fn main() {}' > crates/build-index/src/main.rs \
    && echo 'fn main() {}' > crates/init-copy/src/main.rs \
    && cargo build --release --target x86_64-unknown-linux-musl -p init-copy \
    && rm -rf crates/api/src crates/build-index/src crates/init-copy/src

COPY crates/init-copy/src ./crates/init-copy/src
RUN touch crates/init-copy/src/main.rs \
    && cargo build --release --target x86_64-unknown-linux-musl -p init-copy \
    && strip target/x86_64-unknown-linux-musl/release/init-copy

FROM scratch

COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/init-copy /init-copy

COPY resources/index.bin /index.bin

ENTRYPOINT ["/init-copy"]
