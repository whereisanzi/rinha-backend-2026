FROM --platform=linux/amd64 rust:1.83-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /src

ENV RUSTFLAGS="-C target-cpu=haswell -C target-feature=+avx2,+fma,+bmi2,+popcnt -C link-arg=-s"

COPY Cargo.toml Cargo.lock ./
COPY crates/api/Cargo.toml ./crates/api/Cargo.toml
COPY crates/build-index/Cargo.toml ./crates/build-index/Cargo.toml
RUN mkdir -p crates/api/src crates/build-index/src \
    && echo 'fn main() {}' > crates/api/src/main.rs \
    && echo 'fn main() {}' > crates/build-index/src/main.rs \
    && cargo build --release --target x86_64-unknown-linux-musl -p api \
    && rm -rf crates/api/src crates/build-index/src

COPY crates/api/src ./crates/api/src
RUN touch crates/api/src/main.rs \
    && cargo build --release --target x86_64-unknown-linux-musl -p api \
    && strip target/x86_64-unknown-linux-musl/release/api

FROM scratch

COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/api /api

COPY resources/index.bin /resources/index.bin

ENV INDEX_PATH=/resources/index.bin

ENTRYPOINT ["/api"]
